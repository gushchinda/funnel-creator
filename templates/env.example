# Copy to <funnel>/.env (gitignored) and fill. Never commit the filled file.

# Funnel identity
# optional overrides of funnel.config.json: source (tag on every Stripe/Paddle object) and slug (this variant)
FUNNEL_SOURCE=
FUNNEL_NAME=
# optional: comma-separated sources the status API should also accept
FUNNEL_SOURCES=
# https://quiz.example.com once the domain is live; empty = request host
BASE_URL=
THANK_YOU_PATH=/?step=thank-you

# Payments: stripe | paddle
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# sandbox | production
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

# Meta Pixel + Conversions API
META_PIXEL_ID=
META_CAPI_TOKEN=
# test deploy only
META_TEST_EVENT_CODE=

# Secrets generated per funnel: openssl rand -base64 32
# pay links
TOKEN_SECRET=
# per-user app tokens (rotating it logs every app user out of web access)
ACCESS_TOKEN_SECRET=
# app backend -> GET /v1/subscription
FUNNEL_API_KEY=
# optional push to the app backend
APP_WEBHOOK_URL=
APP_WEBHOOK_SECRET=
GRACE_DAYS=3

# Tools (not needed by the server)
# image generation
FAL_KEY=
# service account key, if gcloud is not logged in
GCLOUD_KEY_JSON=

# Funnel analytics (references/analytics.md)
# dashboard password for /analytics; keep it in Secret Manager on deploys
ANALYTICS_PASSWORD=
# BigQuery dataset written by scripts/setup_analytics.sh
ANALYTICS_DATASET=funnel_analytics

# Welcome email after purchase (references/email.md). Empty provider = no email.
# resend | postmark | sendgrid
EMAIL_PROVIDER=
EMAIL_API_KEY=
# "Acme Sleep <hello@acmesleep.com>", on a domain verified in the email service
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_SUBJECT=

# Subscription service the app uses (references/app-services.md): adapty | revenuecat | apphud | none
APP_SERVICE=none
# uid (the ?uid= the app opens the funnel with) | email
APP_USER_ID_FROM=uid
ADAPTY_SECRET_KEY=
REVENUECAT_STRIPE_PUBLIC_KEY=
APPHUD_CLIENT_ID=
